{
  "languages_detected": ["rust"],
  "build_merged_tree": "git fetch origin <branch> <target>; merge origin/<branch> into a scratch worktree cut from the target tip fetched at gate start; cargo build --all-targets",
  "per_landing": [
    {"name": "build", "cmd": "cargo build --all-targets", "kind": "build"},
    {"name": "clippy", "cmd": "cargo clippy --all-targets -- -D warnings", "kind": "lint"},
    {"name": "tests", "cmd": "cargo test", "kind": "test"}
  ],
  "full_fallback": "cargo test",
  "focused_vs_full": "A name-filter run only localizes a failure. The verdict rests on the whole cargo test run.",
  "zero_match_check": "cargo test <filter> -- --list must list the intended tests; cargo test no_such_test_at_all -- --list must list none",
  "structural_checks": [
    {"name": "formatting", "cmd": "cargo fmt --check", "why": "non-zero means unformatted files"}
  ],
  "generated_files": [],
  "baselines": [],
  "write_capable_targets": ["cargo fmt", "cargo clippy --fix"],
  "per_landing_race": "concurrency_only",
  "runner": "gate_agent",
  "gate_box": "local",
  "merge_king": {"from": "orchestration.merge_kings"},
  "batch": {"every_n_landings": 5, "cmd": "cargo test", "required_for_deploy": true},
  "policy": {"unmeasured_findings_block": false},
  "ratchets": [],
  "tiers": {"philosophy_lens": true, "hotpath_lens": true},
  "verdict_log": "docs/gate-log.md",
  "retention_paths": []
}
