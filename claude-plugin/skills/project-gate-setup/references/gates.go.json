{
  "languages_detected": ["go"],
  "build_merged_tree": "git fetch origin <branch> <target>; merge origin/<branch> into a scratch worktree cut from the target tip fetched at gate start; go build ./...",
  "per_landing": [
    {"name": "build", "cmd": "go build ./...", "kind": "build"},
    {"name": "vet", "cmd": "go vet ./...", "kind": "lint"},
    {"name": "tests", "cmd": "go test ./...", "kind": "test"},
    {"name": "race", "cmd": "go test -race ./...", "kind": "race"}
  ],
  "full_fallback": "go test ./...",
  "focused_vs_full": "A -run selector only localizes a failure. The verdict rests on the whole-package run.",
  "zero_match_check": "go test -list '<selector>' ./pkg must list the intended tests; go test -list '^TestNoSuchThingAtAll$' ./pkg must list none",
  "structural_checks": [
    {"name": "formatting", "cmd": "gofmt -l .", "why": "non-empty output means unformatted files"}
  ],
  "generated_files": [],
  "baselines": [],
  "write_capable_targets": ["gofmt -w", "golangci-lint run --fix", "go generate ./..."],
  "per_landing_race": "concurrency_only",
  "runner": "gate_agent",
  "gate_box": "local",
  "merge_king": {"from": "orchestration.merge_kings"},
  "batch": {"every_n_landings": 5, "cmd": "go test -race ./...", "required_for_deploy": true},
  "policy": {"unmeasured_findings_block": false},
  "ratchets": [],
  "tiers": {"philosophy_lens": true, "hotpath_lens": true},
  "verdict_log": "docs/gate-log.md",
  "retention_paths": []
}
